# ── FinTrace 环境变量配置 ────────────────────────────────────
# 复制为 .env 并填入真实值：
#   cp .env.example .env
#
# Windows:
#   copy .env.example .env

# DeepSeek API（如需 LLM 增强）
# 留空 = 只使用本地稳定模型
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT=20

# LanSmith 可观测性（可选）
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=FinTrace

# 人工反馈记忆路径
# FINTRACE_APPROVAL_MEMORY_PATH=runtime/feedback/approval_memory.json
